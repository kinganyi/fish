{
  "name": "dsh-fish",
  "version": "0.1.0-shadow.0",
  "description": "fish（大肥鱼生命系统）在 DeepSeek Harness 上的官方原生实现：spec/ 契约唯一真源，影子期只读对拍，不注册模型可见工具、不注入上下文。",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "plugin",
    "fish",
    "memory"
  ],
  "type": "module",
  "main": "lib/index.js",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=22.5"
  },
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "README.md",
    "spec"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/unit/core.test.mjs test/unit/apply.test.mjs test/unit/domain.test.mjs test/unit/cli.test.mjs test/unit/t05.test.mjs",
    "gen:spec": "pnpm run build && node scripts/gen-spec.mjs",
    "check:spec": "node scripts/check-spec.mjs",
    "check:contract": "node scripts/check-contract-startup.mjs",
    "verify": "pnpm run typecheck && pnpm run build && pnpm run check:spec && pnpm run check:contract && pnpm run check:readonly && pnpm test",
    "pack": "pnpm pack",
    "check:readonly": "node scripts/check-shadow-readonly.mjs"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.4"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/dsh": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-locale": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-conversation": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-layout": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-sidebar": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.0-rc.2",
    "@deepseek-ai/dsh-commands": "0.2.0-rc.2",
    "@types/node": "22.20.0",
    "@types/react": "~18.3.31",
    "react": "^18.2.0",
    "tsdown": "0.22.2",
    "tsx": "4.22.4",
    "typescript": "6.0.3"
  },
  "license": "MIT"
}
